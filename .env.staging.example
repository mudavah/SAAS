# KaziFlow — STAGING environment template
# Copy to .env.staging (or your secrets manager) and fill in real values.
# Staging mirrors production but uses separate infrastructure.

# ── Core (REQUIRED) ────────────────────────────────────────────────────────────
# Staging PostgreSQL (separate from production).
DATABASE_URL=postgresql://staging:staging@db:5432/kaziflow_staging?sslmode=disable

# Session/JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Staging URLs (can be http for internal staging; https if exposed publicly).
AUTH_URL=http://staging.kaziflow.co.ke
NEXT_PUBLIC_APP_URL=http://staging.kaziflow.co.ke

# Secret used to encrypt integration credentials/OAuth tokens at rest.
APP_ENCRYPTION_KEY=

# ── Cache & rate limiting ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
CACHE_MAX_ENTRIES=2000

# ── Database pool tuning ────────────────────────────────────────────────────────
DATABASE_POOL_MAX=5

# ── Payments & billing ─────────────────────────────────────────────────────────
# Use Stripe test mode keys in staging.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ── M-Pesa Daraja (optional, use sandbox) ──────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://staging.kaziflow.co.ke/api/mpesa/callback
MPESA_ENV=sandbox

# ── AI (optional) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email (optional) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=KaziFlow Staging <noreply+staging@kaziflow.co.ke>

# ── Google OAuth (optional) ────────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Error monitoring (optional) ────────────────────────────────────────────────
SENTRY_DSN=

# ── Observability ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=KaziFlow Staging
