# KaziFlow — PRODUCTION environment template
# Copy to .env.local (or your secrets manager) and fill in real values.
# See docs/PRODUCTION_DEPLOYMENT_CHECKLIST.md for the full launch checklist.

# ── Core (REQUIRED) ────────────────────────────────────────────────────────────
# Pooled PostgreSQL connection string (e.g. Neon/ Supabase/ RDS pooled endpoint).
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/kaziflow?sslmode=require

# Session/JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Canonical URLs (must be https in production).
AUTH_URL=https://app.kaziflow.co.ke
NEXT_PUBLIC_APP_URL=https://app.kaziflow.co.ke

# Secret used to encrypt integration credentials/OAuth tokens at rest.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Cache & rate limiting (RECOMMENDED) ────────────────────────────────────────
# Enables shared cache + distributed rate limiting across instances.
REDIS_URL=rediss://default:pass@redis.example.com:6379
CACHE_MAX_ENTRIES=2000

# ── Database pool tuning ───────────────────────────────────────────────────────
DATABASE_POOL_MAX=10

# ── Payments & billing (REQUIRED for subscriptions) ─────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ── M-Pesa Daraja (optional) ───────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://app.kaziflow.co.ke/api/mpesa/callback
MPESA_ENV=production

# ── AI (optional) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email (optional) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=KaziFlow <hello@kaziflow.co.ke>

# ── Google OAuth (optional) ────────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Error monitoring (optional) ────────────────────────────────────────────────
# Sentry is loaded lazily and is NOT a hard dependency.
SENTRY_DSN=

# ── Observability base URL for client SDKs (optional) ───────────────────────────
NEXT_PUBLIC_APP_NAME=KaziFlow
