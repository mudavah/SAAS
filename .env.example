# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KaziFlow

# Database (Neon or Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/kaziflow

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# M-Pesa Daraja API (Safaricom Sandbox)
# 1. Register at https://developer.safaricom.co.ke
# 2. Create app → enable "Lipa Na M-Pesa Online"
# 3. Copy Consumer Key, Consumer Secret, and Passkey
# 4. Sandbox shortcode is always: 174379
# 5. For local dev, expose callback with ngrok:
#    ngrok http 3000  →  set MPESA_CALLBACK_URL to https://xxxx.ngrok.io/api/mpesa/callback
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/mpesa/callback
MPESA_ENV=sandbox

# AI (OpenAI or compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (Resend) — https://resend.com
# 1. Sign up free at resend.com
# 2. Create an API key → paste below
# 3. For testing: leave EMAIL_FROM empty (uses onboarding@resend.dev)
#    You can only send to YOUR Resend account email until you verify a domain
# 4. For production: verify your domain in Resend, then set EMAIL_FROM
RESEND_API_KEY=re_...
EMAIL_FROM=Your Business <hello@yourdomain.com>

# ── Integration Hub (Epic 11) ────────────────────────────────────────────────
# All keys below are OPTIONAL. The Integration Hub stores provider credentials
# per-connection in the database (encrypted). When a server-level key is set
# here it is used as a fallback for the matching provider. No new dependencies.
# Other providers (Pesapal, Flutterwave, Africa's Talking, Twilio, WhatsApp,
# Google/Microsoft OAuth, QuickBooks, Xero, Dropbox) are configured per
# connection inside the Integration Hub UI.

# Secret used to encrypt integration credentials/OAuth tokens at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Google OAuth (Calendar/Drive) — also used by the Integration Hub OAuth flow
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...

# Microsoft (Outlook Calendar / OneDrive) OAuth — register an app in Entra ID
# INTEGRATION_MICROSOFT_CLIENT_ID=
# INTEGRATION_MICROSOFT_CLIENT_SECRET=

# QuickBooks Online OAuth — https://developer.intuit.com
# INTEGRATION_QUICKBOOKS_CLIENT_ID=
# INTEGRATION_QUICKBOOKS_CLIENT_SECRET=

# Xero OAuth — https://developer.xero.com
# INTEGRATION_XERO_CLIENT_ID=
# INTEGRATION_XERO_CLIENT_SECRET=

# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
# INTEGRATION_WHATSAPP_CLIENT_ID=
# INTEGRATION_WHATSAPP_CLIENT_SECRET=

# Encryption (secrets at rest)
APP_ENCRYPTION_KEY=generate-a-random-32-char-string

# Integration Hub (optional — adapters degrade gracefully when absent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
AFRICAS_TALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_KEY=
FCM_SERVER_KEY=
DROPBOX_ACCESS_TOKEN=
